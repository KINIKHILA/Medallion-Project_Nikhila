# =============================================================================
# Medallion Pipeline — Environment Variables Example
# Copy this file to ".env" and fill in ONE provider's API key below.
# Never commit your real ".env" file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM_PROVIDER: choose which AI provider to use.
# Options: "groq", "gemini", "openai", "github"
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Groq (fast AI inference)
# Get your key at: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Other options: openai/gpt-oss-120b, llama-3.1-8b-instant, openai/gpt-oss-20b
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Google Gemini
# Get your key at: https://makersuite.google.com/app/apikey
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# -----------------------------------------------------------------------------
# OpenAI / ChatGPT
# Get your key at: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# Other options: gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# GitHub Models
# Get your token at: https://github.com/settings/tokens
# -----------------------------------------------------------------------------
GITHUB_TOKEN=your_github_token_here

# Other options: openai/gpt-4o, openai/gpt-4o-mini
GITHUB_MODEL=openai/gpt-4.1-mini
