# Select one provider: groq, gemini, openai, or github
LLM_PROVIDER=groq

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API key: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# GitHub token for GitHub Models: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_BASE_URL=https://models.inference.ai.azure.com

# Optional: OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: GitHub Models model (default: openai/gpt-4.1-mini)
GITHUB_MODEL=openai/gpt-4.1-mini

# Embedding model (default: models/text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004

# Optional email notification settings (leave SMTP_HOST blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Sensitive: store the SMTP/app password here; never commit .env
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Optional PostgreSQL export (leave DATABASE_URL blank to disable)
# Sensitive: include an encoded password in the URL; never commit .env
DATABASE_URL=
GOLD_DB_SCHEMA=public

# Optional per-million-token pricing for cost estimates (USD)
# Set current rates for the selected provider/model; leave blank if unknown.
LLM_INPUT_COST_PER_1M_TOKENS=
LLM_OUTPUT_COST_PER_1M_TOKENS=

# Required to enable the Streamlit admin dashboard; use a unique, strong password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
